# Copy to .env.local (local runs) or set in Vercel (Project Settings > Environment Variables).

# The Aztec node. The browsers and the settler both use it.
AZTEC_NODE_URL=https://aztec-testnet.drpc.org
# The free dRPC plan refuses JSON-RPC batches of more than 3 requests.
AZTEC_NODE_MAX_BATCH_SIZE=3
# The deployed registry (`node --env-file=.env.testnet deploy.ts` in ../scripts prints it).
REGISTRY_ADDRESS=0x18b41975b6265c16f1debf308070c866fad699802392c4e14f4a4597cc05ba38
# The block explorer, for tx links.
EXPLORER_URL=https://testnet.aztecscan.xyz

# The MetaLeX settler account: the keys that `aztec-wallet create-account` printed. Keep the signing key secret.
SETTLER_SIGNING_KEY=
SETTLER_SALT=0x0
SETTLER_ACCOUNT_TYPE=schnorr

# Postgres. On Vercel, the Neon integration sets it.
DATABASE_URL=
# Encrypts each salt in the data key store: 32 random bytes as hex (`openssl rand -hex 32`). In production this key
# belongs in a KMS.
ENCRYPTION_KEY=
