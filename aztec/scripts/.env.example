# Copy to .env.testnet and fill it. Keep the copy out of git: it holds signing keys.
AZTEC_NODE_URL=https://aztec-testnet.drpc.org
# The free dRPC plan refuses JSON-RPC batches of more than 3 requests.
AZTEC_NODE_MAX_BATCH_SIZE=3
# Hides the info logs of the wallet, so that `deploy.ts` shows only its own lines.
LOG_LEVEL=warn

# The environment to deploy. Each label gives its own set of contracts. See `deployments.ts`.
# Production: `MetaLex-v1.1.0`. Staging and development: a semver pre-release, `MetaLex-v1.1.0-dev.0`.
DEPLOY_SALT_LABEL=MetaLex-v1.1.0-dev.0

# The deployer (MetaLeX) for `deploy.ts`. It is the BorgAuthV2 root, so it controls the registry upgrades. On a
# testnet it is also the root and the officer of the test corp auth. Use a separate account from the settler: the
# settler key runs in the web app server.
DEPLOYER_SIGNING_KEY=
DEPLOYER_SALT=0x0
DEPLOYER_ACCOUNT_TYPE=schnorr

# The web app officers of the test corp auth (`deploy-test-corp-auth.ts`), on a testnet only: Aztec addresses, comma
# separated. Each is an initial officer, with no role delay. A change gives the test corp auth a new address.
TEST_CORP_OFFICERS=

# The settler (MetaLeX): the keys that `aztec-wallet create-account` printed. Any account type.
SETTLER_SIGNING_KEY=
SETTLER_SALT=0x0
SETTLER_ACCOUNT_TYPE=schnorr

# The parties: `aztec-wallet create-account --type schnorr_initializerless --register-only`.
ALICE_SIGNING_KEY=
ALICE_SALT=0x0
BOB_SIGNING_KEY=
BOB_SALT=0x0
