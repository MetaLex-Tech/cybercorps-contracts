        ));
    }

    function buildCertificateSVG(
        CertificateSVGParams memory params,
        uint256 timestamp
    ) internal view returns (string memory) {
        return string(abi.encodePacked(
            _getSVGHeader(),
            _getSVGBackground(),
            CertificateImageContentBuilder.buildSVGContent(params, timestamp),
            _getSVGFooter()
        ));
