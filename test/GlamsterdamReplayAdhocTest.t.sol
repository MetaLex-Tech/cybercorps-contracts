pragma solidity ^0.8.28;

import "forge-std/Test.sol";
import {GasBudget} from "./libs/GasBudget.sol";

/// @notice Replays mainnet transactions that touched the MetaLeX Labs cert printers. Each test forks
///         just before its transaction, sends the same call from the same sender, and logs the gas.
///         Run once with `--evm-version prague` and once with the default `amsterdam`.
/// forge-config: default.isolate = true
contract GlamsterdamReplayAdhocTest is Test {
    function _replay(string memory label, bytes32 txHash, address from, address to, uint256 value, bytes memory data)
        internal
    {
        vm.createSelectFork(vm.envString("RPC_URL_ETHEREUM"), txHash);
        vm.prank(from, from);
        uint256 start = gasleft();
        (bool ok, bytes memory ret) = to.call{value: value}(data);
        uint256 total = start - gasleft();
        uint256 execution = GasBudget.lastExecutionGas();
        if (!ok) {
            console2.log(string.concat("REPLAY|", label, "|REVERT"));
            console2.logBytes(ret);
            revert("replay reverted");
        }
        console2.log(string.concat("REPLAY|", label, "|", vm.toString(total), "|", vm.toString(execution)));
    }

